NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Required. Local MongoDB or a MongoDB Atlas SRV URI.
MONGODB_URI=mongodb://127.0.0.1:27017/sliceraft

ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@sliceraft.local
ADMIN_PASSWORD=Admin@12345
ADMIN_ALERT_EMAIL=admin@sliceraft.local

# Optional in development. When omitted, the server creates an Ethereal test
# SMTP account and logs preview URLs for verification/reset/low-stock emails.
# Required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SliceCraft <no-reply@sliceraft.local>

# Razorpay test-mode keys. In development, if these are omitted, checkout
# automatically uses a demo payment and marks the order paid without Razorpay.
# Required in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

LOW_STOCK_COOLDOWN_MINUTES=360
PENDING_ORDER_TTL_MINUTES=20
PASSWORD_RESET_TTL_MINUTES=60
